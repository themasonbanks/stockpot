{
  "name": "stockpot",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:mobile": "turbo dev --filter=@stockpot/mobile",
    "dev:api": "turbo dev --filter=@stockpot/api",
    "test": "turbo test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
