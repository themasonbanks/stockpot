{
  "name": "stockpot",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:mobile": "turbo dev --filter=@stockpot/mobile",
    "dev:api": "turbo dev --filter=@stockpot/api",
    "test": "bun run test:scripts && turbo test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "db:test": "supabase test db",
    "db:types": "bun scripts/generate-database-types.ts",
    "typecheck": "turbo typecheck",
    "test:scripts": "bun test scripts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "supabase": "^2.113.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
